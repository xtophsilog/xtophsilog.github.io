# Copy to .env and adjust.
PORT=5000
# Origins allowed to call the API from another domain (comma-separated).
# Not needed when the API also serves the site, as it does on Render.
CLIENT_ORIGIN=http://localhost:5173

# Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account (created on first start if no user exists).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Database. Leave DATABASE_URL empty to use a local SQLite file (DB_FILE, relative to server/).
# In production, use a hosted Turso database: DATABASE_URL=libsql://<db>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DB_FILE=data/portfolio.db

# Optional: email notifications for new contact messages.
# Leave SMTP_HOST empty to only store messages in the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Portfolio <no-reply@example.com>"
MAIL_TO=you@example.com
